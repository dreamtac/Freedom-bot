{
  "name": "freedom-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Discord bot for game news notifications",
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/check-node-version.mjs",
    "predev": "node scripts/check-node-version.mjs",
    "dev": "tsx watch src/index.ts",
    "prestart": "node scripts/check-node-version.mjs",
    "build": "tsc -p tsconfig.json",
    "backup:db": "node scripts/backup-database.mjs",
    "start": "node dist/index.js",
    "check:news": "tsx src/check-news.ts",
    "check:eternal-return": "tsx src/check-eternal-return.ts",
    "audit:er-receipts": "tsx src/audit-eternal-return-receipts.ts",
    "manage:eternal-return": "tsx src/manage-eternal-return-users.ts",
    "list:news": "tsx src/list-news.ts",
    "update:stocks": "tsx src/update-domestic-stocks.ts",
    "update:overseas-stocks": "tsx src/update-overseas-stocks.ts",
    "register:commands": "tsx src/register-commands.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "date-holidays": "^3.34.1",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "fflate": "^0.8.3",
    "ws": "^8.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "undici": "^6.27.0"
  }
}
