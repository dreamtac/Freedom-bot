# Discord Developer Portal의 Bot 페이지에서 발급받은 토큰
DISCORD_BOT_TOKEN=

# Discord Developer Portal의 General Information에 있는 Application ID
DISCORD_CLIENT_ID=

# 개발 서버 ID. 비워두면 슬래시 명령어가 전역으로 등록됩니다.
DISCORD_GUILD_ID=

# 새 게임 공지를 전송할 Discord 채널 ID
DISCORD_NOTIFICATION_CHANNEL_ID=

# 공지 확인 주기(밀리초). 기본값은 5분입니다.
NEWS_POLL_INTERVAL_MS=300000

# 국내·미국 종목 검색 목록 갱신 주기(밀리초). 기본값은 24시간입니다.
STOCK_MASTER_REFRESH_INTERVAL_MS=86400000

# 한국투자증권 Open API. /시세 명령어를 쓰려면 두 값을 함께 입력합니다.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
# KIS 실시간 체결 WebSocket 주소입니다. 모의투자는 ws://ops.koreainvestment.com:31000 을 사용합니다.
KIS_WS_URL=ws://ops.koreainvestment.com:21000
