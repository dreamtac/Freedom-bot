# Discord Developer Portal의 Bot 페이지에서 발급받은 토큰
DISCORD_BOT_TOKEN=

# Discord Developer Portal의 General Information에 있는 Application ID
DISCORD_CLIENT_ID=

# 개발 서버 ID. 비워두면 슬래시 명령어가 전역으로 등록됩니다.
DISCORD_GUILD_ID=

# 새 게임 공지를 전송할 Discord 채널 ID
DISCORD_NOTIFICATION_CHANNEL_ID=

# 공지 확인 주기(밀리초). 기본값은 5분입니다.
NEWS_POLL_INTERVAL_MS=300000
